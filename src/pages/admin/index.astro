---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
---

<Layout title="Gallery Admin">
	<section class="signed-out" id="signed-out">
		<h1>Gallery admin</h1>
		<p>Sign in to manage your photos.</p>
		<button class="primary-button" id="sign-in" type="button">Sign in</button>
	</section>

	<div id="signed-in" hidden>
		<header class="admin-header">
			<h1>Add photo</h1>
			<details class="admin-menu">
				<summary aria-label="Open menu">
					<span class="menu-open"><Icon name="menu" /></span>
					<span class="menu-close"><Icon name="close" /></span>
				</summary>
				<nav aria-label="Admin menu">
					<a href="/"><Icon name="gallery" />Gallery</a>
					<button id="sign-out" type="button"><Icon name="logout" />Sign out</button>
				</nav>
			</details>
		</header>

		<main class="admin-main">
			<section class="upload-section">
				<form id="upload-form">
					<label class="drop-zone" id="drop-zone">
						<input class="visually-hidden" id="photo-input" name="photo" type="file" accept="image/jpeg,image/png,image/webp" required />
						<Icon name="addPhoto" />
						<strong>Drop a photo here</strong>
						<span>or browse</span>
						<small id="selected-file"></small>
					</label>

					<label>
						Caption <span>(optional)</span>
						<textarea name="caption" maxlength="240" rows="3"></textarea>
					</label>

					<div class="field-row">
						<label>
							City
							<input name="city" list="city-options" maxlength="80" />
						</label>
						<label>
							Tags <span>(comma separated)</span>
							<input name="tags" maxlength="240" />
						</label>
					</div>
					<datalist id="city-options"></datalist>

					<button class="primary-button" id="publish-button" type="submit" disabled>Publish photo</button>
					<p class="form-status" id="form-status" role="status"></p>
				</form>
			</section>

			<section class="photo-list-section">
				<h2>Photos</h2>
				<p class="list-status" id="list-status">Loading photos…</p>
				<div class="table-wrap">
					<table id="photo-table" hidden>
						<thead><tr><th>Photo</th><th>Caption</th><th>City</th><th>Tags</th><th>Created</th><th>Status</th><th><span class="visually-hidden">Edit</span></th></tr></thead>
						<tbody id="photo-list"></tbody>
					</table>
				</div>
			</section>
		</main>
	</div>

	<dialog id="edit-dialog">
		<form id="edit-form" method="dialog">
			<div class="dialog-heading">
				<h2>Edit photo</h2>
				<button class="icon-button" value="cancel" aria-label="Close edit dialog"><Icon name="close" /></button>
			</div>
			<img class="edit-preview" id="edit-preview" alt="" />
			<label>Caption <span>(optional)</span><textarea id="edit-caption" maxlength="240" rows="3"></textarea></label>
			<label>City<input id="edit-city" list="city-options" maxlength="80" /></label>
			<label>Tags <span>(comma separated)</span><input id="edit-tags" maxlength="240" /></label>
			<label class="checkbox-label"><input id="edit-hidden" type="checkbox" /> Hide from gallery</label>
			<p class="form-status" id="edit-status" role="status"></p>
			<div class="dialog-actions">
				<button class="danger-button" id="open-delete" type="button">Delete</button>
				<span></span>
				<button class="secondary-button" value="cancel">Cancel</button>
				<button class="primary-button" id="save-edit" type="button">Save</button>
			</div>
		</form>
	</dialog>

	<dialog id="delete-dialog">
		<div class="confirm-dialog">
			<h2>Delete photo?</h2>
			<p>This permanently removes the photo and cannot be undone.</p>
			<div class="dialog-actions">
				<button class="secondary-button" id="cancel-delete" type="button">Cancel</button>
				<button class="danger-button" id="confirm-delete" type="button">Delete photo</button>
			</div>
		</div>
	</dialog>
</Layout>

<script>
	import { authIsConfigured, finishSignIn, getAccessToken, signIn, signOut } from "../../lib/auth";
	import type { MediaItem } from "../../lib/media";

	const apiUrl = import.meta.env.PUBLIC_API_URL?.replace(/\/$/, "");
	const signedOut = document.querySelector<HTMLElement>("#signed-out");
	const signedIn = document.querySelector<HTMLElement>("#signed-in");
	const signInButton = document.querySelector<HTMLButtonElement>("#sign-in");
	const signOutButton = document.querySelector<HTMLButtonElement>("#sign-out");
	const form = document.querySelector<HTMLFormElement>("#upload-form");
	const photoInput = document.querySelector<HTMLInputElement>("#photo-input");
	const publishButton = document.querySelector<HTMLButtonElement>("#publish-button");
	const selectedFile = document.querySelector<HTMLElement>("#selected-file");
	const dropZone = document.querySelector<HTMLElement>("#drop-zone");
	const formStatus = document.querySelector<HTMLParagraphElement>("#form-status");
	const listStatus = document.querySelector<HTMLParagraphElement>("#list-status");
	const table = document.querySelector<HTMLTableElement>("#photo-table");
	const list = document.querySelector<HTMLTableSectionElement>("#photo-list");
	const cityOptions = document.querySelector<HTMLDataListElement>("#city-options");
	const editDialog = document.querySelector<HTMLDialogElement>("#edit-dialog");
	const deleteDialog = document.querySelector<HTMLDialogElement>("#delete-dialog");
	const editPreview = document.querySelector<HTMLImageElement>("#edit-preview");
	const editCaption = document.querySelector<HTMLTextAreaElement>("#edit-caption");
	const editCity = document.querySelector<HTMLInputElement>("#edit-city");
	const editTags = document.querySelector<HTMLInputElement>("#edit-tags");
	const editHidden = document.querySelector<HTMLInputElement>("#edit-hidden");
	const editStatus = document.querySelector<HTMLParagraphElement>("#edit-status");
	let currentItem: MediaItem | undefined;
	let items: MediaItem[] = [];

	function parseTags(value: FormDataEntryValue | string | null) {
		return [...new Set(String(value || "").split(",").map((tag) => tag.trim()).filter(Boolean))];
	}

	async function authorizedRequest(path: string, options: RequestInit = {}) {
		const token = getAccessToken();
		if (!token) throw new Error("Please sign in again.");
		return fetch(`${apiUrl}${path}`, {
			...options,
			headers: { "content-type": "application/json", authorization: `Bearer ${token}`, ...options.headers },
		});
	}

	function formatDate(value: string) {
		return `${new Intl.DateTimeFormat(undefined, { dateStyle: "medium", timeStyle: "short", timeZone: "UTC" }).format(new Date(value))} UTC`;
	}

	function updateCities() {
		if (!cityOptions) return;
		cityOptions.replaceChildren();
		[...new Set(items.map((item) => item.city).filter(Boolean))].sort().forEach((city) => {
			const option = document.createElement("option");
			option.value = city;
			cityOptions.append(option);
		});
	}

	function openEditor(item: MediaItem) {
		currentItem = item;
		if (editPreview) editPreview.src = item.thumbnailUrl;
		if (editCaption) editCaption.value = item.caption;
		if (editCity) editCity.value = item.city;
		if (editTags) editTags.value = item.tags.join(", ");
		if (editHidden) editHidden.checked = Boolean(item.hidden);
		if (editStatus) editStatus.textContent = "";
		editDialog?.showModal();
	}

	function renderList() {
		if (!list || !table || !listStatus) return;
		list.replaceChildren();
		items.forEach((item) => {
			const row = document.createElement("tr");
			if (item.hidden) row.className = "hidden-photo";

			const photoCell = document.createElement("td");
			const image = document.createElement("img");
			image.className = "table-photo";
			image.src = item.thumbnailUrl;
			image.alt = "";
			photoCell.append(image);

			const captionCell = document.createElement("td");
			captionCell.className = "caption-cell";
			captionCell.textContent = item.caption || "—";

			const cityCell = document.createElement("td");
			cityCell.textContent = item.city || "—";

			const tagsCell = document.createElement("td");
			tagsCell.textContent = item.tags.length ? item.tags.map((tag) => `#${tag}`).join(" ") : "—";

			const dateCell = document.createElement("td");
			dateCell.textContent = formatDate(item.createdAt);

			const statusCell = document.createElement("td");
			statusCell.textContent = item.hidden ? "Hidden" : "Visible";

			const actionCell = document.createElement("td");
			const editButton = document.createElement("button");
			editButton.className = "icon-button";
			editButton.type = "button";
			editButton.setAttribute("aria-label", `Edit ${item.caption || "photo"}`);
			const icon = document.createElement("span");
			icon.className = "edit-symbol";
			icon.textContent = "✎";
			icon.setAttribute("aria-hidden", "true");
			editButton.append(icon);
			editButton.addEventListener("click", () => openEditor(item));
			actionCell.append(editButton);
			row.append(photoCell, captionCell, cityCell, tagsCell, dateCell, statusCell, actionCell);
			list.append(row);
		});
		table.hidden = !items.length;
		listStatus.hidden = items.length > 0;
		listStatus.textContent = items.length ? "" : "No photos yet.";
		updateCities();
	}

	async function loadPhotos() {
		if (listStatus) listStatus.textContent = "Loading photos…";
		const response = await authorizedRequest("/admin/media");
		if (!response.ok) throw new Error("Photos could not be loaded.");
		items = await response.json();
		renderList();
	}

	async function resizePhoto(file: File, maximum: number, quality: number) {
		const source = await createImageBitmap(file);
		const scale = Math.min(1, maximum / Math.max(source.width, source.height));
		const width = Math.round(source.width * scale);
		const height = Math.round(source.height * scale);
		const canvas = document.createElement("canvas");
		canvas.width = width;
		canvas.height = height;
		canvas.getContext("2d")?.drawImage(source, 0, 0, width, height);
		source.close();
		const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/webp", quality));
		if (!blob) throw new Error("The photo could not be prepared.");
		return { blob, width, height };
	}

	async function uploadFile(url: string, file: Blob, contentType: string) {
		const response = await fetch(url, { method: "PUT", headers: { "content-type": contentType }, body: file });
		if (!response.ok) throw new Error("The photo could not be uploaded.");
	}

	function selectFile(file?: File) {
		if (!file || !photoInput || !publishButton) return;
		const transfer = new DataTransfer();
		transfer.items.add(file);
		photoInput.files = transfer.files;
		publishButton.disabled = false;
		if (selectedFile) selectedFile.textContent = file.name;
	}

	if (!authIsConfigured || !apiUrl) {
		if (signInButton) signInButton.disabled = true;
		const message = signedOut?.querySelector("p");
		if (message) message.textContent = "The private admin connection has not been configured yet.";
	} else {
		try {
			await finishSignIn();
			if (getAccessToken()) {
				if (signedOut) signedOut.hidden = true;
				if (signedIn) signedIn.hidden = false;
				await loadPhotos();
			}
		} catch (error) {
			const message = signedOut?.querySelector("p");
			if (message) message.textContent = error instanceof Error ? error.message : "Sign-in failed.";
		}
	}

	signInButton?.addEventListener("click", signIn);
	signOutButton?.addEventListener("click", signOut);
	photoInput?.addEventListener("change", () => selectFile(photoInput.files?.[0]));
	["dragenter", "dragover"].forEach((name) => dropZone?.addEventListener(name, (event) => { event.preventDefault(); dropZone.classList.add("is-dragging"); }));
	["dragleave", "drop"].forEach((name) => dropZone?.addEventListener(name, (event) => { event.preventDefault(); dropZone.classList.remove("is-dragging"); }));
	dropZone?.addEventListener("drop", (event) => selectFile(event.dataTransfer?.files[0]));

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const photo = data.get("photo");
		if (!(photo instanceof File) || !photo.size) return;
		if (publishButton) publishButton.disabled = true;
		if (formStatus) formStatus.textContent = "Preparing photo…";
		try {
			const createResponse = await authorizedRequest("/uploads", {
				method: "POST",
				body: JSON.stringify({ caption: data.get("caption"), city: data.get("city"), tags: parseTags(data.get("tags")), contentType: photo.type }),
			});
			if (!createResponse.ok) throw new Error("The upload could not be started.");
			const urls = await createResponse.json();
			const [display, thumbnail] = await Promise.all([resizePhoto(photo, 1800, 0.84), resizePhoto(photo, 640, 0.78)]);
			if (formStatus) formStatus.textContent = "Publishing photo…";
			await Promise.all([
				uploadFile(urls.originalUrl, photo, photo.type),
				uploadFile(urls.displayUrl, display.blob, "image/webp"),
				uploadFile(urls.thumbnailUrl, thumbnail.blob, "image/webp"),
			]);
			const completeResponse = await authorizedRequest(`/uploads/${urls.id}/complete`, { method: "POST", body: JSON.stringify({ width: display.width, height: display.height }) });
			if (!completeResponse.ok) throw new Error("The upload could not be completed.");
			form.reset();
			if (selectedFile) selectedFile.textContent = "";
			if (formStatus) formStatus.textContent = "Published.";
			await loadPhotos();
		} catch (error) {
			if (formStatus) formStatus.textContent = error instanceof Error ? error.message : "The upload failed.";
		} finally {
			if (publishButton) publishButton.disabled = !photoInput?.files?.length;
		}
	});

	document.querySelector("#save-edit")?.addEventListener("click", async () => {
		if (!currentItem) return;
		if (editStatus) editStatus.textContent = "Saving…";
		try {
			const response = await authorizedRequest(`/media/${currentItem.id}`, {
				method: "PUT",
				body: JSON.stringify({ caption: editCaption?.value, city: editCity?.value, tags: parseTags(editTags?.value || ""), hidden: editHidden?.checked }),
			});
			if (!response.ok) throw new Error("The changes could not be saved.");
			await loadPhotos();
			editDialog?.close();
		} catch (error) {
			if (editStatus) editStatus.textContent = error instanceof Error ? error.message : "Save failed.";
		}
	});

	document.querySelector("#open-delete")?.addEventListener("click", () => deleteDialog?.showModal());
	document.querySelector("#cancel-delete")?.addEventListener("click", () => deleteDialog?.close());
	document.querySelector("#confirm-delete")?.addEventListener("click", async () => {
		if (!currentItem) return;
		const response = await authorizedRequest(`/media/${currentItem.id}`, { method: "DELETE" });
		if (!response.ok) {
			if (editStatus) editStatus.textContent = "The photo could not be deleted.";
			deleteDialog?.close();
			return;
		}
		deleteDialog?.close();
		editDialog?.close();
		await loadPhotos();
	});
</script>

<style>
	.signed-out {
		width: min(100% - 2rem, 28rem);
		margin: 15vh auto;
		padding: 2rem;
		background: #fff;
		border: 1px solid var(--line);
		text-align: center;
	}

	.signed-out h1,
	.signed-out p {
		margin-top: 0;
	}

	.admin-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: min(100% - 2rem, 68rem);
		margin: 0 auto;
		padding: 1.25rem 0;
	}

	.admin-header h1 {
		margin: 0;
		font-size: 1.35rem;
	}

	.admin-menu {
		position: relative;
	}

	.admin-menu summary {
		position: relative;
		z-index: 4;
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		border: 1px solid var(--line);
		border-radius: 50%;
		cursor: pointer;
		list-style: none;
	}

	.admin-menu summary::-webkit-details-marker,
	.admin-menu:not([open]) .menu-close,
	.admin-menu[open] .menu-open {
		display: none;
	}

	.admin-menu nav {
		position: fixed;
		top: 0;
		right: 0;
		z-index: 3;
		display: grid;
		align-content: start;
		width: min(20rem, 25vw);
		height: 100dvh;
		padding: 6rem 1.25rem 1.25rem;
		background: #fff;
		border-left: 1px solid var(--line);
		box-shadow: -0.75rem 0 2rem rgb(0 0 0 / 8%);
		animation: drawer-in 180ms ease-out;
	}

	.admin-menu[open]::before {
		position: fixed;
		inset: 0;
		z-index: 2;
		content: "";
		background: rgb(0 0 0 / 32%);
	}

	:global(body:has(.admin-menu[open])) {
		overflow: hidden;
	}

	@keyframes drawer-in {
		from {
			transform: translateX(100%);
		}
	}

	.admin-menu a,
	.admin-menu nav button {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.7rem;
		color: inherit;
		background: none;
		border: 0;
		cursor: pointer;
		font: inherit;
		text-align: left;
		text-decoration: none;
	}

	.admin-menu a:hover,
	.admin-menu nav button:hover {
		background: var(--background);
	}

	.admin-main {
		width: min(100% - 2rem, 68rem);
		margin: 1rem auto 5rem;
	}

	.upload-section {
		max-width: 48rem;
		margin-bottom: 4rem;
	}

	form,
	label {
		display: grid;
		gap: 0.45rem;
	}

	form {
		gap: 1rem;
	}

	label {
		flex: 1;
		font-size: 0.9rem;
		font-weight: 600;
	}

	label span {
		color: var(--muted);
		font-size: 0.8rem;
		font-weight: 400;
	}

	input,
	textarea {
		width: 100%;
		padding: 0.65rem 0.75rem;
		color: var(--foreground);
		background: #fff;
		border: 1px solid var(--line);
		resize: vertical;
	}

	.field-row {
		display: flex;
		gap: 1rem;
	}

	.drop-zone {
		min-height: 12rem;
		place-items: center;
		align-content: center;
		gap: 0.35rem;
		padding: 1.5rem;
		border: 1px dashed var(--muted);
		cursor: pointer;
		text-align: center;
	}

	.drop-zone.is-dragging {
		background: #e8eee9;
		border-color: var(--green);
	}

	.drop-zone :global(.icon) {
		width: 2.25rem;
		height: 2.25rem;
	}

	.drop-zone .icon {
		font-size: 2.25rem;
	}

	.drop-zone small {
		margin-top: 0.5rem;
		color: var(--green);
	}

	.primary-button,
	.secondary-button,
	.danger-button {
		min-height: 2.75rem;
		padding: 0.65rem 1rem;
		cursor: pointer;
	}

	.primary-button {
		width: fit-content;
		color: #fff;
		background: var(--green);
		border: 1px solid var(--green);
	}

	.primary-button:disabled {
		cursor: not-allowed;
		opacity: 0.5;
	}

	.secondary-button {
		background: transparent;
		border: 1px solid var(--line);
	}

	.danger-button {
		color: #fff;
		background: #9f2f2f;
		border: 1px solid #9f2f2f;
	}

	.form-status,
	.list-status {
		min-height: 1.2rem;
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.photo-list-section h2 {
		font-size: 1.2rem;
	}

	.table-wrap {
		overflow-x: auto;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		border: 1px solid var(--line);
		font-size: 0.84rem;
	}

	th,
	td {
		padding: 0.5rem 0.65rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: middle;
	}

	th {
		color: var(--muted);
		background: #f5f5f5;
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}

	tbody tr:hover {
		background: #f8f8f8;
	}

	.table-photo {
		display: block;
		width: 2.5rem;
		height: 2.5rem;
		object-fit: cover;
		background: #f1f1f1;
	}

	td {
		max-width: 13rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.caption-cell {
		min-width: 11rem;
	}

	.edit-symbol {
		font-size: 1.25rem;
		line-height: 1;
	}

	.hidden-photo {
		opacity: 0.55;
	}

	dialog {
		width: min(100% - 2rem, 34rem);
		padding: 0;
		background: var(--background);
		border: 1px solid var(--line);
	}

	dialog::backdrop {
		background: rgb(0 0 0 / 45%);
	}

	dialog form,
	.confirm-dialog {
		padding: 1.5rem;
	}

	.dialog-heading,
	.dialog-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.dialog-heading {
		justify-content: space-between;
	}

	.dialog-heading h2,
	.confirm-dialog h2 {
		margin: 0;
		font-size: 1.2rem;
	}

	.edit-preview {
		display: block;
		width: 5rem;
		height: 5rem;
		object-fit: contain;
		background: #f3f3f3;
	}

	.checkbox-label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.checkbox-label input {
		width: auto;
	}

	.dialog-actions span {
		flex: 1;
	}

	.confirm-dialog .dialog-actions {
		justify-content: flex-end;
		margin-top: 1.5rem;
	}

	@media (max-width: 600px) {
		.admin-menu nav {
			width: min(22rem, 84vw);
		}

		.field-row {
			display: grid;
		}

		.admin-main {
			margin-top: 0;
		}

		.dialog-actions {
			flex-wrap: wrap;
		}
	}
</style>
