---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Photo — Gallery" pageClass="viewer-page">
	<header class="viewer-header">
		<a class="icon-link" href="/" aria-label="Back to gallery">
			<span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
		</a>
	</header>

	<main class="viewer" aria-live="polite">
		<a class="icon-link viewer-arrow" id="previous-desktop" href="/" aria-label="Previous photo">
			<span class="material-symbols-rounded" aria-hidden="true">arrow_back_ios_new</span>
		</a>

		<figure class="photo-view">
			<div class="image-window">
				<p class="status-message" id="media-status">Loading photo…</p>
				<img id="media-image" alt="" hidden />
			</div>
			<figcaption id="media-caption" hidden>
				<p class="photo-caption" id="photo-caption"></p>
				<p class="media-details" id="media-details"></p>
				<div class="media-tags" id="media-tags"></div>
			</figcaption>
		</figure>

		<a class="icon-link viewer-arrow" id="next-desktop" href="/" aria-label="Next photo">
			<span class="material-symbols-rounded" aria-hidden="true">arrow_forward_ios</span>
		</a>

		<nav class="mobile-controls" aria-label="Photo navigation">
			<a class="icon-link" id="previous-mobile" href="/" aria-label="Previous photo">
				<span class="material-symbols-rounded" aria-hidden="true">arrow_back_ios_new</span>
			</a>
			<a class="icon-link" id="next-mobile" href="/" aria-label="Next photo">
				<span class="material-symbols-rounded" aria-hidden="true">arrow_forward_ios</span>
			</a>
		</nav>
	</main>
</Layout>

<script>
	import { getMedia, listMedia } from "../../lib/media";

	const id = decodeURIComponent(location.pathname.split("/").filter(Boolean).at(-1) || "");
	const status = document.querySelector<HTMLParagraphElement>("#media-status");
	const image = document.querySelector<HTMLImageElement>("#media-image");
	const figureCaption = document.querySelector<HTMLElement>("#media-caption");
	const photoCaption = document.querySelector<HTMLParagraphElement>("#photo-caption");
	const details = document.querySelector<HTMLParagraphElement>("#media-details");
	const tags = document.querySelector<HTMLDivElement>("#media-tags");
	const previousLinks = ["#previous-desktop", "#previous-mobile"];
	const nextLinks = ["#next-desktop", "#next-mobile"];

	function setLinks(selectors: string[], href: string) {
		selectors.forEach((selector) => {
			const link = document.querySelector<HTMLAnchorElement>(selector);
			if (link) link.href = href;
		});
	}

	try {
		const [item, items] = await Promise.all([getMedia(id), listMedia()]);
		if (!item) throw new Error("Photo not found");

		const index = items.findIndex((photo) => photo.id === item.id);
		const previous = items[(index - 1 + items.length) % items.length];
		const next = items[(index + 1) % items.length];
		const created = new Intl.DateTimeFormat(undefined, {
			dateStyle: "medium",
			timeStyle: "short",
			timeZone: "UTC",
		}).format(new Date(item.createdAt));

		if (image) {
			image.src = item.displayUrl;
			image.alt = item.caption;
			image.width = item.width;
			image.height = item.height;
			image.hidden = false;
		}
		if (photoCaption) {
			photoCaption.textContent = item.caption;
			photoCaption.hidden = !item.caption;
		}
		if (details) details.textContent = [item.city, `${created} UTC`].filter(Boolean).join(" · ");
		item.tags.forEach((tag) => {
			const span = document.createElement("span");
			span.textContent = tag;
			tags?.append(span);
		});
		if (figureCaption) figureCaption.hidden = false;
		if (status) status.hidden = true;
		document.title = `${item.caption || "Photo"} — Gallery`;

		if (previous && next) {
			setLinks(previousLinks, `/media/${previous.id}`);
			setLinks(nextLinks, `/media/${next.id}`);
			document.addEventListener("keydown", (event) => {
				if (event.key === "ArrowLeft") location.href = `/media/${previous.id}`;
				if (event.key === "ArrowRight") location.href = `/media/${next.id}`;
			});
		}
	} catch {
		if (status) status.textContent = "This photo could not be found.";
	}
</script>

<style is:global>
	html:has(.viewer-page) {
		height: 100%;
		overflow: hidden;
	}

	.viewer-page {
		height: 100dvh;
		overflow: hidden;
	}
</style>

<style>
	.viewer-header {
		display: flex;
		align-items: center;
		height: 4rem;
		padding: 0 clamp(1rem, 3vw, 2rem);
	}

	.viewer {
		display: grid;
		grid-template-columns: 3rem minmax(0, 58rem) 3rem;
		align-items: center;
		justify-content: center;
		gap: clamp(1rem, 4vw, 4rem);
		height: calc(100dvh - 4rem);
		padding: 0.75rem clamp(1rem, 4vw, 3rem) 1.5rem;
	}

	.photo-view {
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto;
		gap: 0.85rem;
		min-width: 0;
		height: 100%;
		margin: 0;
		text-align: center;
	}

	.image-window {
		display: grid;
		min-height: 0;
		place-items: center;
	}

	.image-window img {
		display: block;
		width: 100%;
		height: 100%;
		min-height: 0;
		object-fit: contain;
	}

	.photo-view figcaption {
		min-height: 3.25rem;
	}

	.photo-view p {
		margin: 0.2rem 0;
	}

	.photo-caption {
		font-size: 0.95rem;
	}

	.media-details {
		color: var(--muted);
		font-size: 0.78rem;
	}

	.media-tags {
		display: flex;
		justify-content: center;
		gap: 0.45rem;
		margin-top: 0.35rem;
	}

	.media-tags span {
		color: var(--muted);
		font-size: 0.75rem;
	}

	.media-tags span::before {
		content: "#";
	}

	.viewer-arrow {
		justify-self: center;
	}

	.mobile-controls {
		display: none;
	}

	@media (max-width: 700px) {
		.viewer {
			grid-template-columns: 1fr;
			grid-template-rows: minmax(0, 1fr) 3rem;
			gap: 0.5rem;
			padding: 0.5rem 0.75rem 0.75rem;
		}

		.viewer-arrow {
			display: none;
		}

		.mobile-controls {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 2rem;
		}
	}
</style>
